+# These are application log tokens, not proof of location or deliberate action.
+_TZ_TEXT = re.compile(r"prevTimezone\( *([^(),\r\n]*) *\), *newTimezone\( *([^(),\r\n]*) *\)(?:, *now\( *(-?[0-9]+) *\))?")
+_TZ_TOKEN = re.compile(r"[A-Za-z0-9_+./:-]{1,128}")
+
+def _timezone_fields(stamp, value):
+    status = []
+    timestamp = None
+    if type(stamp) is not int:
+        status.append('unsupported_timestamp_type')
+    else:
+        try:
+            timestamp = datetime.datetime(1970, 1, 1, tzinfo=datetime.timezone.utc) + datetime.timedelta(milliseconds=stamp)
+        except (OverflowError, ValueError):
+            status.append('timestamp_out_of_range')
+    previous = new = embedded_now = None
+    match = _TZ_TEXT.fullmatch(value) if isinstance(value, str) and len(value) <= 65536 else None
+    if match is None:
+        status.append('unparsed_timezone_text')
+    else:
+        previous, new = match[1].strip(), match[2].strip()
+        embedded_now = match[3]  # Preserve decimal text; not substituted for row time.
+        if (previous and not _TZ_TOKEN.fullmatch(previous)) or not _TZ_TOKEN.fullmatch(new):
+            status.append('unsupported_timezone_token')
+        if previous == '':
+            status.append('empty_previous_as_stored')
+    return timestamp, previous, new, embedded_now, ';'.join(status) or 'parsed_tokens_only'
+
+TZ_PARSER_REVISION = 'staged-2026-10-12-v3'
+_TZ_ASCII_LOWER = str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')
+
+def _timezone_identity(value):
+    return (value.st_dev, value.st_ino, value.st_mode, value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+
+def _timezone_source_state(path):
+    result = {}
+    for suffix in ('', '-wal', '-shm', '-journal'):
+        p = Path(str(path) + suffix)
+        if any(x.is_symlink() for x in (p, *p.parents)):
+            raise ValueError('Timezone source symlink refused')
+        if not p.exists():
+            if not suffix:
+                raise ValueError('Timezone main database missing')
+            continue
+        if p.is_symlink() or not p.is_file() or p.stat().st_size > 256 * 1024**2:
+            raise ValueError('Unsupported timezone source type/size')
+        before = p.stat(); digest = hashlib.sha256(); count = 0
+        with p.open('rb') as source:
+            if _timezone_identity(os.fstat(source.fileno())) != _timezone_identity(before):
+                raise ValueError('Timezone source identity changed')
+            for chunk in iter(lambda: source.read(1024**2), b''):
+                count += len(chunk)
+                if count > before.st_size or count > 256 * 1024**2:
+                    raise ValueError('Timezone source grew during hash')
+                digest.update(chunk)
+            if _timezone_identity(os.fstat(source.fileno())) != _timezone_identity(before):
+                raise ValueError('Timezone source identity changed during read')
+        after = p.stat()
+        if (before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) or count != before.st_size:
+            raise ValueError('Timezone source changed during hash')
+        result[suffix or 'main'] = {'bytes': count, 'sha256': digest.hexdigest()}
+    return result
+
+@contextlib.contextmanager
+def _timezone_snapshot(path):
+    state = _timezone_source_state(path)
+    with tempfile.TemporaryDirectory(prefix='aleapp-timezone-') as directory:
+        copied = Path(directory).resolve() / 'dwbCommon.db'
+        for label, item in state.items():
+            suffix = '' if label == 'main' else label
+            source_path = Path(str(path) + suffix)
+            target_path = Path(str(copied) + suffix)
+            with source_path.open('rb') as source, target_path.open('xb') as target:
+                before = source_path.stat()
+                if _timezone_identity(os.fstat(source.fileno())) != _timezone_identity(before):
+                    raise ValueError('Timezone source identity changed before copy')
+                written = 0
+                while True:
+                    chunk = source.read(min(1024**2, item['bytes'] - written + 1))
+                    if not chunk:
+                        break
+                    written += len(chunk)
+                    if written > item['bytes']:
+                        raise ValueError('Timezone snapshot growth refused')
+                    target.write(chunk)
+                if written != item['bytes'] or _timezone_identity(os.fstat(source.fileno())) != _timezone_identity(before) or _timezone_identity(source_path.stat()) != _timezone_identity(before):
+                    raise ValueError('Timezone source changed during copy')
+        if _timezone_source_state(copied) != state or _timezone_source_state(path) != state:
+            raise ValueError('Timezone snapshot/source changed or mismatch')
+        try:
+            yield str(copied), state
+        finally:
+            if _timezone_source_state(path) != state:
+                raise ValueError('Samsung Logging source state changed')
