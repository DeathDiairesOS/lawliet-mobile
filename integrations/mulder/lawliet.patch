+
+    Date bounds accept YYYY-MM-DD (UTC midnight) or timezone-aware ISO
+    timestamps with up to six fractional digits. Both bounds are inclusive and
+    normalized to UTC microseconds; empty, malformed and zone-unknown bounds
+    are rejected. Date constraints exclude undated records and never normalize
+    unknown source timestamps. Category/app/conversation use exact indexed values; participant
+    is a literal casefold substring in message metadata. phone_query matches
+    one 7–15-digit number using existing indexed phone-field normalization,
+    not contact identity inference. Combined filters are ANDed. Returns at
+    most 1000 records per page. offset must be 0–1000000 and limit 1–1000;
+    both require actual integers, not strings, floats or booleans. Ordering is
+    UTC then artifact ID, undated last, for an unchanged case. Pages use separate
+    database snapshots; restart at offset 0 if the case changes. No total count
+    or whole-source completeness is inferred.
+    """
+    from lawliet_mobile.core import connect, select_artifacts
+    if type(offset) is not int or not 0 <= offset <= 1000000:
+        raise ValueError('offset must be an integer between 0 and 1000000')
+    if type(limit) is not int or not 1 <= limit <= 1000:
+        raise ValueError('limit must be an integer between 1 and 1000')
+    from lawliet_mobile.parsers import timestamp
+    import re
+    requested_bounds = {'since': since, 'until': until}
+    def effective_bound(value, name):
+        if value is None:
+            return None
+        if (not isinstance(value, str) or not re.fullmatch(r'\d{4}-\d{2}-\d{2}(?:[Tt ].+)?', value)
+                or re.search(r'[.,]\d{7}', value)):
+            raise ValueError(name + ' must be YYYY-MM-DD or a timezone-aware ISO timestamp with at most six fractional digits')
+        normalized = timestamp(value + 'T00:00:00Z' if len(value) == 10 else value)
+        if normalized is None:
+            raise ValueError(name + ' must be YYYY-MM-DD or a timezone-aware ISO timestamp')
+        return normalized
+    since = effective_bound(since, 'since')
+    until = effective_bound(until, 'until')
+    root = _ancalor_review_case(case_path)
+    with connect(root.parent, root.name) as (_, db):
+        rows = select_artifacts(db, query=query, since=since, until=until, category=category,
+                                app=app, conversation=conversation, participant=participant,
+                                phone_query=phone_query, limit=limit+1, offset=offset)
+    return {'query': query, 'since': since, 'until': until,
+            'requested_bounds': requested_bounds,
+            'category': category, 'app': app, 'conversation': conversation,
+            'participant': participant, 'phone_query': phone_query, 'records': rows[:limit],
+            'returned_records': min(len(rows),limit), 'truncated': offset > 0 or len(rows) > limit,
+            'offset': offset, 'limit': limit, 'has_more': len(rows) > limit,
+            'next_offset': offset+limit if len(rows) > limit and offset+limit <= 1000000 else None,
+            'pagination_limit_reached': len(rows) > limit and offset+limit > 1000000,
+            'window_scope': 'Returned matching indexed-record window only; earlier rows may be omitted when offset > 0. Total not computed; no source completeness claim. Pages are stable only while the case is unchanged.',
+            'undated_behavior': 'Date constraints exclude records without known UTC time'}
+
+
+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def save_ancalor_finding(case_path: str, artifact_id: str, note: str) -> dict[str, object]:
+    """Save an examiner interpretation tied to an exact retained source record.
+
+    Notes are examiner claims, never original evidence. Writes checksum/audit
+    protected findings and readable/JSONL exports in this retained review case.
+    """
+    from lawliet_mobile.core import connect
+    from lawliet_mobile.findings import add_finding, export_findings
+    root = _ancalor_review_case(case_path)
+    with connect(root.parent, root.name) as (_, db):
+        result = add_finding(db, artifact_id, note, examiner='Codex/Mulder technical validation')
+        export_findings(root, db, root/('exports/findings-'+result['id']+'.jsonl'), 'jsonl')
+        export_findings(root, db, root/('exports/findings-'+result['id']+'.txt'), 'text')
+    return {'finding': result, 'exports': str(root/'exports'), 'independent_review': 'pending'}
+
+
+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def run_ancalor_native_review(evidence_path: str, platform: str = 'auto', max_input_bytes: int = 2 * 1024**3) -> dict[str, object]:
+    """Preserve and parse a supplied native extraction through local Lawliet.
+
+    Downstream candidate adapter. Uses Lawliet's explicit native schema parsers,
+    retaining their coverage/warnings. No model execution, archive expansion,
+    deleted-data recovery or media fetch. max_input_bytes must be exactly
+    2147483648 (2 GiB default) or 3221225472 (3 GiB); at most100000 files.
+    Zero artifacts does not establish an empty device.
+    """
+    from lawliet_mobile.core import create_case, connect, import_evidence, select_artifacts, verify
+    from lawliet_mobile.parsers import native_analyze
+    from lawliet_mobile.report import write_export, write_report
+    tc_id = make_tool_call_id();t0 = time.monotonic();params={'evidence_path':evidence_path, 'platform':platform, 'max_input_bytes':max_input_bytes}
+    if type(max_input_bytes) is not int or max_input_bytes not in {2*1024**3, 3*1024**3}:
+        return error_response(tc_id,'run_ancalor_native_review',params,
+                              'max_input_bytes must be exactly 2147483648 (2 GiB) or 3221225472 (3 GiB).',error_type='invalid_input')
+    if platform not in {'auto', 'android', 'ios'}:
+        return error_response(tc_id,'run_ancalor_native_review',params,
+                              'Platform must be auto, android or ios',error_type='invalid_input')
+    path = Path(evidence_path)
+    if path.is_symlink() or not path.exists():
+        return error_response(tc_id,'run_ancalor_native_review',params,'Regular file/directory required',error_type='invalid_input')
+    workspace = Path(get_ctx().db.db_path).parent/'lawliet-review';case_id='NATIVE-'+str(tc_id).replace('_','-')
+    create_case(workspace,case_id,examiner='Codex/Mulder native candidate adapter')
+    with connect(workspace,case_id) as (root,db):
+        eid,files,size = import_evidence(root,db,path,platform,max_bytes=max_input_bytes,max_files=100000,expand_archives=False)
+        result = native_analyze(root,db,eid)
+        rows = select_artifacts(db,limit=None)
+        write_export(root,db,root/'exports/records.jsonl','jsonl',rows)
+        write_report(root,db,root/'exports/review.html')
+        integrity = verify(root,db)
+    retained={'case_path':str(root),'jsonl':str(root/'exports/records.jsonl'),'html':str(root/'exports/review.html')}
+    header={'scope':'Selected supplied native files only; no completeness/recovery/identity assurance','retained':retained,'parser_result':result,'received_files':files,'received_bytes':size,'platform':platform,'max_input_bytes':max_input_bytes}
+    indexed=extract_and_index('\n'.join([json.dumps(header,ensure_ascii=False)]+[json.dumps(r,ensure_ascii=False) for r in rows]),'phone.lawliet_native',str(path),'lawliet-native-adapter/2')
+    indexed.update(header);indexed.update(records=len(rows),record_count_unit='Lawliet artifacts',originals_unchanged=integrity['ok'])
+    response=tool_response(tc_id,'run_ancalor_native_review',params,indexed,'phone.lawliet_native',(time.monotonic()-t0)*1000);response['result']=indexed;return response
+
+# Register the optional, bounded supplied-SQLite recovery adapter.
+from mulder.server.tools import lawliet_recovery as _ancalor_recovery  # noqa: E402,F401
