+def _case():
+    from lawliet_mobile.agent_collection_endpoint import BINDING_KEY, case_binding, parent_location
+    from lawliet_mobile.core import UserError
+    if os.environ.get('LAWLIET_MCP_PROFILE') != 'android-workflow':
+        raise UserError('Use the dedicated approved-collection endpoint.')
+    path = os.environ.get('LAWLIET_COLLECTION_CASE')
+    if not path:
+        raise UserError('The host did not select a collection case.')
+    binding = case_binding(path)
+    encoded = json.dumps(binding, sort_keys=True)
+    ctx = get_ctx()
