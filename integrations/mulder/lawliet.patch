+    meta = ctx.db.get_case_metadata()
+    case_id = ctx.case_id
+    if (not isinstance(case_id, str) or not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", case_id)
+            or database.name != case_id + ".db" or meta.case_id != case_id):
+        raise ValueError("Active case identity is invalid for SQLite carving")
+    evidence = Path(meta.evidence_root).absolute()
+    for path in (database, evidence, image):
+        if any(part.is_symlink() for part in (path, *path.parents)):
+            raise ValueError("Linked case/evidence paths are not supported for SQLite carving")
+    if not database.is_file() or not image.is_file():
+        raise ValueError("Regular active case database and evidence image are required")
+    database, evidence, image = database.resolve(), evidence.resolve(), image.resolve()
+    if not (image == evidence if evidence.is_file() else evidence.is_dir() and image.is_relative_to(evidence)):
