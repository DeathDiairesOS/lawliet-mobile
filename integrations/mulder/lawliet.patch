+def parse_google_maps_foreground_location(case_path: str, file_id: int) -> dict[str, object]:
+    """Decode the tested Google Maps 9.77.5 last-foreground preference layout.
+
+    Hash-verified retained XML source, exact base64/protobuf bytes, provisional
