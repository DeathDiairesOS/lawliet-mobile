@@ -0,0 +1,90 @@
+"""Bounded supplied-SQLite recovery; no device or physical-drive acquisition."""
+from __future__ import annotations
+import hashlib
+import json
+import shutil
+import subprocess
+import time
+from pathlib import Path
+from mulder.server.app import get_ctx, mcp
+from mulder.server.extract_helpers import extract_and_index
+from mulder.server.helpers import error_response, make_tool_call_id, tool_response
+from mulder.server.tool_access import Role, tool_access
+
+
+def _hash(path: Path) -> str:
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def run_ancalor_sqlite_recovery(evidence_path: str) -> dict[str, object]:
+    """Carve candidates from one supplied decrypted SQLite DB and companions.
+
+    Requires pinned SQLite Dissect 1.0.0. Copies regular DB/-wal/-shm/-journal
+    inputs (combined 512 MiB max), retains originals, logs, CSVs and audited
+    candidate records. Carved candidates are NOT confirmed deleted messages.
+    WAL pairing stays unverified. No device access or encrypted-key guessing.
+    Zero candidates never proves no deletion. Runtime bounded to 120 seconds.
+    """
+    from lawliet_mobile.core import create_case, connect, import_evidence, select_artifacts, verify, UserError
+    from lawliet_mobile.recovery import recover_sqlite
+    from lawliet_mobile.report import write_export, write_report
+    from lawliet_mobile.tools import configure
+    tc_id=make_tool_call_id();started=time.monotonic();params={'evidence_path':evidence_path}
+    supplied=Path(evidence_path)
+    if supplied.is_symlink() or not supplied.is_file():
+        return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'A regular supplied SQLite file is required',error_type='invalid_input')
+    with supplied.open('rb') as stream:header=stream.read(20)
+    if header[:16]!=b'SQLite format 3\x00':
+        return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'Decrypted SQLite header required; encrypted/corrupt input is not a negative recovery result',error_type='unsupported_or_corrupt')
+    sources=[supplied]
+    for suffix in ('-wal','-shm','-journal'):
+        sidecar=Path(str(supplied)+suffix)
+        if sidecar.is_symlink() or (sidecar.exists() and not sidecar.is_file()):
+            return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'Companions must be regular supplied files',error_type='invalid_input')
+        if sidecar.exists():sources.append(sidecar)
+    if sum(p.stat().st_size for p in sources)>512*1024**2:
+        return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'Combined SQLite inputs exceed 512 MiB',error_type='input_limit')
+    engine=shutil.which('sqlite-dissect')
+    if not engine:
+        return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'Pinned SQLite Dissect launcher not available',error_type='tool_unavailable')
+    version=subprocess.run([engine,'--version'],capture_output=True,text=True,timeout=10)
+    if version.returncode or version.stdout.strip()!='version 1.0.0':
+        return error_response(tc_id,'run_ancalor_sqlite_recovery',params,'This adapter requires SQLite Dissect 1.0.0',error_type='unsupported_version')
+    parent_database=Path(get_ctx().db.db_path)
+    workspace=parent_database.parent/'lawliet-review';case_id='RECOVERY-'+str(tc_id).replace('_','-')
+    create_case(workspace,case_id,examiner='Codex/Mulder candidate recovery')
+    case=workspace/case_id
+    from lawliet_mobile.mulder_ownership import bind_review_case
+    bind_review_case(case,parent_database,tc_id)
+    stage=case/'supplied';stage.mkdir()
+    receipt=[];retained={'case_path':str(case),'intake_manifest':str(case/'supplied-manifest.json')}
+    try:
+        for source in sources:
+            before=_hash(source);copy=stage/source.name;shutil.copyfile(source,copy)
+            if before!=_hash(source) or before!=_hash(copy):raise UserError('Supplied SQLite input changed during copying')
+            receipt.append({'path':str(source),'retained':str(copy),'sha256':before,'size':copy.stat().st_size})
+        (case/'supplied-manifest.json').write_text(json.dumps(receipt,indent=2))
+        (case/'engine-version.txt').write_text(version.stdout)
+        configure(case,'sqlite-dissect',engine)
+        with connect(workspace,case_id) as (root,db):
+            eid=import_evidence(root,db,stage,'unknown',expand_archives=False)[0]
+            file_id=db.execute('SELECT id FROM files WHERE evidence_id=? AND path=?',(eid,supplied.name)).fetchone()[0]
+            result=recover_sqlite(root,db,case,file_id,120)
+            rows=select_artifacts(db,run=result['run_id'],limit=100001)
+            if len(rows)>100000:raise UserError('Recovery candidate export exceeds100000 rows; retained case requires scoped review')
+            write_export(root,db,root/'exports/candidates.jsonl','jsonl',rows)
+            write_report(root,db,root/'exports/review.html')
+            integrity=verify(root,db)
+        if not integrity['ok'] or any(_hash(Path(row['path']))!=row['sha256'] for row in receipt):raise UserError('Post-analysis source integrity check failed')
+        retained.update(jsonl=str(case/'exports/candidates.jsonl'),html=str(case/'exports/review.html'),run=str(case/'runs'/result['run_id']))
+        summary={'state':'limited','candidates':len(rows),'retained':retained,'engine':'sqlite-dissect/1.0.0','originals_unchanged':True,'wal_present':Path(str(supplied)+'-wal').exists(),'wal_pairing':'unverified','scope':'Recovery observations require examiner corroboration; no confirmed message/deletion attribution; zero candidates is not clearance.'}
+        indexed=extract_and_index('\n'.join([json.dumps(summary)]+[json.dumps(row,ensure_ascii=False) for row in rows]),'phone.lawliet_recovery',str(supplied),'lawliet-sqlite-recovery/1')
+        indexed.update(summary)
+        response=tool_response(tc_id,'run_ancalor_sqlite_recovery',params,indexed,'phone.lawliet_recovery',(time.monotonic()-started)*1000);response['result']=indexed;return response
+    except (UserError,OSError,ValueError) as exc:
+        response=error_response(tc_id,'run_ancalor_sqlite_recovery',params,str(exc),error_type='recovery_failed')
+        response['retained']=retained
+        return response
