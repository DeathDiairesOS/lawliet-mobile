+def _carving_paths(ctx: Any, image_path: str) -> tuple[Path, Path]:
+    """Confine this operation to the active evidence and a fresh case run.
+
+    This application-level guard is not an operating-system sandbox. Refuse
+    linked paths and ambiguous case ownership before creating derivatives.
+    """
+    image = Path(image_path).absolute()
