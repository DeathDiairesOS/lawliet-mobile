+def _android_archive_names(path: Path, limit: int) -> list[str]:
+    import stat
+    import zipfile
+    names = []
+    seen = set()
+    total = 0
+    with zipfile.ZipFile(path) as archive:
+        for member in archive.infolist():
+            name = member.filename
+            if (not name or name.startswith('/') or '\\' in name or ':' in name or '\x00' in name
+                    or any(part in {'.', '..'} for part in name.split('/'))
+                    or member.flag_bits & 1
+                    or stat.S_IFMT(member.external_attr >> 16) not in {0, stat.S_IFREG, stat.S_IFDIR}
+                    or name in seen):
+                raise ValueError('Unsafe or encrypted ZIP member; supply a qualified regular-file extraction')
+            names.append(name)
+            seen.add(name)
+            total += member.file_size
+            if len(names) > _ANDROID_MVT_MAX_FILES or total > limit:
+                raise ValueError('ZIP exceeds the declared expanded byte/member budget')
+    return names
