+@tool_access(Role.EXTRACT_EXECUTOR)
+def collect_lawliet_android_contacts(
+    case_path: str, serial: str, max_contacts: StrictInt = 1000,
+    android_user: StrictInt | None = None, timeout_seconds: StrictInt = 60,
+    max_bytes: StrictInt = 8 * 1024**2,
+) -> dict[str, object]:
+    """Explicit bounded contacts-provider observations into this active case's review child.
+
+    Fixed read-only contacts/name/phone/email queries, one explicit serial and
+    Android user. Omitted user is observed before and after collection; every
+    query remains pinned to the first observed user. No discovery, root, grants,
