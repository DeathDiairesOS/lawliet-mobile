+              'max_bytes': max_bytes, 'prefix_commitment': hash_output(prefix)}
+    try:
+        with connect(root.parent, root.name) as (root, db):
+            result = collect_sms(root, db, root.parent, serial,
+                                 timeout=timeout_seconds, max_bytes=max_bytes,
+                                 max_messages=max_messages, user=android_user, prefix=prefix)
