index 0000000..7e16475
--- /dev/null
+++ b/src/mulder/server/case_scope.py
@@ -0,0 +1,123 @@
+"""Application-level read scope for one active forensic case.
+
+This policy rejects shared-store and sibling-case access. It does not replace an
+OS sandbox or authorize arbitrary external parser inputs on tools that bypass it.
+"""
+from __future__ import annotations
+
+import json
+import threading
+from functools import wraps
+from pathlib import Path
+from mulder.path_policy import PathPolicyError, resolve_allowed_path
+
+_ROOTS_KEY = 'lawliet.case_owned_roots.v1'
+_MAX_ROOTS = 10000
+_claim_lock = threading.Lock()
+
+def _serialized_claim(fn):
+    @wraps(fn)
+    def wrapped(*args, **kwargs):
+        with _claim_lock:
+            return fn(*args, **kwargs)
+    return wrapped
+
+
+def _ordinary(path: Path) -> Path:
+    if not path.is_absolute() or any(p.is_symlink() for p in (path, *path.parents)):
+        raise PathPolicyError('Absolute unlinked case paths are required')
+    return path.resolve()
+
+
+def case_identity(ctx=None):
+    from mulder.server.app import get_ctx, validate_case_id
+    ctx = ctx or get_ctx()
+    meta = ctx.db.get_case_metadata()
+    case_id = ctx.case_id
+    try:
+        validate_case_id(case_id)
+    except (ValueError, TypeError) as exc:
+        raise PathPolicyError('Active case identity is invalid') from exc
+    database = _ordinary(Path(ctx.db.db_path))
+    if meta.case_id != case_id or database.name != case_id + '.db' or not database.is_file():
+        raise PathPolicyError('Active case database identity is invalid')
+    root = meta.evidence_root
+    if not isinstance(root, str) or not root.strip():
+        raise PathPolicyError('An absolute evidence root must be recorded for the case')
+    evidence = _ordinary(Path(root))
+    if not (evidence.is_file() or evidence.is_dir()):
+        raise PathPolicyError('Recorded case evidence root is unavailable')
+    return ctx, database, evidence, {'case_id': case_id, 'ingested_at': meta.ingested_at}
+
+
+def _claims(ctx, identity):
+    raw = ctx.db.get_kv(_ROOTS_KEY)
+    if raw is None:
+        return []
+    if len(raw) > 2 * 1024**2:
+        raise PathPolicyError('Case-owned roots registry exceeds its bound')
+    try:
+        value = json.loads(raw)
+    except (ValueError, RecursionError) as exc:
+        raise PathPolicyError('Case-owned roots registry is invalid') from exc
+    if (not isinstance(value, dict) or value.get('owner') != identity
+            or not isinstance(value.get('roots'), list) or len(value['roots']) > _MAX_ROOTS
+            or any(not isinstance(p, str) for p in value['roots'])):
+        raise PathPolicyError('Case-owned roots registry does not match the active case')
+    return value['roots']
+
+
+@_serialized_claim
+def register_retained_root(path: Path, ctx=None) -> None:
+    """Claim a completed engine-created derivative in its active case database."""
+    ctx, database, evidence, identity = case_identity(ctx)
+    path = _ordinary(Path(path))
+    parent = _ordinary(database.parent / 'retained-tools')
+    if path.parent != parent or not path.is_dir() or (evidence.is_dir() and path.is_relative_to(evidence)):
+        raise PathPolicyError('Retained root must be a direct unlinked derived-output child')
+    roots = _claims(ctx, identity)
+    if str(path) not in roots:
+        if len(roots) >= _MAX_ROOTS:
+            raise PathPolicyError('Case-owned roots registry is full')
+        roots.append(str(path))
+        ctx.db.set_kv(_ROOTS_KEY, json.dumps({'owner': identity, 'roots': roots}))
+
+
+def case_read_roots(ctx=None) -> list[Path]:
+    ctx, database, evidence, identity = case_identity(ctx)
+    roots = [evidence, database]
+    for suffix in ('.audit.jsonl', '.report.md', '.report.html', '.report.pdf'):
+        roots.append(_ordinary(database.with_suffix(suffix)))
+    for family in ('extracted', 'carved_sqlite'):
+        roots.append(_ordinary(database.parent / family / ctx.case_id))
+    parent = _ordinary(database.parent / 'retained-tools')
+    for claimed in _claims(ctx, identity):
+        root = _ordinary(Path(claimed))
+        if root.parent != parent:
+            raise PathPolicyError('Invalid retained-output ownership claim')
+        roots.append(root)
+    return roots
+
+
+def resolve_case_read_path(target: Path, ctx=None) -> Path:
+    ctx, database, evidence, identity = case_identity(ctx)
+    target = _ordinary(target.expanduser().absolute())
+    roots = case_read_roots(ctx)
+    try:
+        return resolve_allowed_path(target, roots)
+    except PathPolicyError:
+        # Review cases already have an independently audited parent binding.
+        for family in ('lawliet-review', 'ancalor-review'):
+            parent = _ordinary(database.parent / family)
+            if target.is_relative_to(parent):
+                relative = target.relative_to(parent)
+                if not relative.parts:
+                    break
+                root = parent / relative.parts[0]
+                try:
+                    from lawliet_mobile.mulder_ownership import require_review_case
+                    root = require_review_case(root, database)
+                except Exception as exc:
+                    raise PathPolicyError('Review output is not owned by this active case') from exc
+                return resolve_allowed_path(target, [root])
+        raise PathPolicyError('Access denied: outside active evidence or proven case-owned output; reimport unclaimed legacy output explicitly')
