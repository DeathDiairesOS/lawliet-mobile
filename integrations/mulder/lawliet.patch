+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def collect_lawliet_android_sms(
+    case_path: str, serial: str, max_messages: StrictInt = 1000,
+    android_user: StrictInt | None = None, prefix: str | None = None,
+    timeout_seconds: StrictInt = 60, max_bytes: StrictInt = 8 * 1024**2,
+) -> dict[str, object]:
+    """Explicit bounded live SMS-provider collection into a retained review case.
+
+    Invoke only for an authorized collection from the explicitly supplied
+    device serial. No discovery/default device selection, root, installation,
+    permission grant, clock adjustment, backup or external model invocation.
+    case_path must be a direct review child of the active Mulder case. Uses
+    that review workspace's configured ADB. android_user selects a profile;
+    when omitted, the collector observes the current Android user. prefix is
+    an optional provider-side body selector, not a general query language.
+    Returns collection/run receipts, not message bodies. Use the existing
+    review query/export routes for retained records. Failure/partial/empty
+    results remain distinct; no MMS/RCS/private-app or whole-device coverage.
+    Live services may log reads. Per-record observations are not one atomic
+    snapshot. Physical field fidelity still requires independent device seeds.
+    """
+    from lawliet_mobile.core import connect
+    from lawliet_mobile.provider_sms import collect_sms
+    if type(timeout_seconds) is not int or not 1 <= timeout_seconds <= 300:
+        raise ValueError('timeout_seconds must be an integer from 1 to 300')
+    if type(max_bytes) is not int or not 1 <= max_bytes <= 64 * 1024**2:
+        raise ValueError('max_bytes must be an integer from 1 to 67108864')
+    if type(max_messages) is not int or not 1 <= max_messages <= 20000:
+        raise ValueError('max_messages must be an integer from 1 to 20000')
+    if android_user is not None and (type(android_user) is not int or not 0 <= android_user <= 2147483647):
+        raise ValueError('android_user must be a nonnegative integer')
+    if not isinstance(serial, str) or not _re.fullmatch(r'[A-Za-z0-9_.:-]+', serial) or serial.startswith('-'):
+        raise ValueError('Supply an explicit valid device serial')
