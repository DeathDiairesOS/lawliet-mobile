+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def query_ancalor_review(case_path: str, query: str = '', since: str | None = None,
+                         until: str | None = None, category: str | None = None,
+                         app: str | None = None, conversation: str | None = None,
+                         participant: str | None = None, phone_query: str | None = None,
+                         offset: StrictInt = 0, limit: StrictInt = 1000) -> dict[str, object]:
+    """Search a retained Ancalor export case with literal Unicode matching.
+
+    Date bounds accept YYYY-MM-DD (UTC midnight) or timezone-aware ISO
+    timestamps with up to six fractional digits. Both bounds are inclusive and
+    normalized to UTC microseconds; empty, malformed and zone-unknown bounds
+    are rejected. Date constraints exclude undated records and never normalize
+    unknown source timestamps. Category/app/conversation use exact indexed values; participant
+    is a literal casefold substring in message metadata. phone_query matches
+    one 7–15-digit number using existing indexed phone-field normalization,
+    not contact identity inference. Combined filters are ANDed. Returns at
+    most 1000 records per page. offset must be 0–1000000 and limit 1–1000;
+    both require actual integers, not strings, floats or booleans. Ordering is
+    UTC then artifact ID, undated last, for an unchanged case. Pages use separate
+    database snapshots; restart at offset 0 if the case changes. No total count
+    or whole-source completeness is inferred.
+    """
+    from lawliet_mobile.core import connect, select_artifacts
+    if type(offset) is not int or not 0 <= offset <= 1000000:
+        raise ValueError('offset must be an integer between 0 and 1000000')
+    if type(limit) is not int or not 1 <= limit <= 1000:
+        raise ValueError('limit must be an integer between 1 and 1000')
+    from lawliet_mobile.parsers import timestamp
+    import re
+    requested_bounds = {'since': since, 'until': until}
+    def effective_bound(value, name):
+        if value is None:
+            return None
+        if (not isinstance(value, str) or not re.fullmatch(r'\d{4}-\d{2}-\d{2}(?:[Tt ].+)?', value)
+                or re.search(r'[.,]\d{7}', value)):
+            raise ValueError(name + ' must be YYYY-MM-DD or a timezone-aware ISO timestamp with at most six fractional digits')
+        normalized = timestamp(value + 'T00:00:00Z' if len(value) == 10 else value)
+        if normalized is None:
+            raise ValueError(name + ' must be YYYY-MM-DD or a timezone-aware ISO timestamp')
+        return normalized
+    since = effective_bound(since, 'since')
+    until = effective_bound(until, 'until')
+    root = _ancalor_review_case(case_path)
+    tc_id, started = make_tool_call_id(), time.monotonic()
+    params = {'case_path': str(root), 'offset': offset, 'limit': limit,
+              'filter_commitment': hash_output({'query': query, 'since': since, 'until': until,
+                  'category': category, 'app': app, 'conversation': conversation,
+                  'participant': participant, 'phone_query': phone_query})}
+    try:
+        with connect(root.parent, root.name) as (_, db):
+            rows = select_artifacts(db, query=query, since=since, until=until, category=category,
+                                    app=app, conversation=conversation, participant=participant,
+                                    phone_query=phone_query, limit=limit+1, offset=offset)
+    except Exception as exc:
+        error_response(tc_id, 'query_ancalor_review', params, type(exc).__name__,
+                       (time.monotonic()-started)*1000, error_type='execution')
+        raise
+    result = {'query': query, 'since': since, 'until': until,
+            'requested_bounds': requested_bounds,
+            'category': category, 'app': app, 'conversation': conversation,
+            'participant': participant, 'phone_query': phone_query, 'records': rows[:limit],
+            'returned_records': min(len(rows),limit), 'truncated': offset > 0 or len(rows) > limit,
+            'offset': offset, 'limit': limit, 'has_more': len(rows) > limit,
+            'next_offset': offset+limit if len(rows) > limit and offset+limit <= 1000000 else None,
+            'pagination_limit_reached': len(rows) > limit and offset+limit > 1000000,
+            'window_scope': 'Returned matching indexed-record window only; earlier rows may be omitted when offset > 0. Total not computed; no source completeness claim. Pages are stable only while the case is unchanged.',
+            'undated_behavior': 'Date constraints exclude records without known UTC time'}
+    tool_response(tc_id, 'query_ancalor_review', params, result, elapsed_ms=(time.monotonic()-started)*1000)
+    return result
