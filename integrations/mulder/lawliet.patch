+def _android_inventory(path: Path, limit: int, copy_to: Path | None = None) -> list[dict[str, object]]:
+    """Hash/copy through anchored no-follow descriptors, bounding files and bytes."""
+    import hashlib
+    import os
+    import stat
+    from contextlib import ExitStack
+    files, total, entries = [], 0, 0
+    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+    def visit(fd, relative, destination, depth=0):
+        nonlocal total, entries
+        entries += 1
+        if entries > _ANDROID_MVT_MAX_FILES or depth > 64:
+            raise ValueError('Evidence exceeds entry/depth budget')
+        before = os.fstat(fd)
+        if stat.S_ISDIR(before.st_mode):
+            if destination:
+                destination.mkdir()
+            with os.scandir(fd) as stream:
+                for entry in stream:
+                    child = os.open(entry.name, flags, dir_fd=fd)
+                    try:
+                        visit(child, relative / entry.name, destination / entry.name if destination else None, depth + 1)
+                    finally:
+                        os.close(child)
+            return
+        if not stat.S_ISREG(before.st_mode):
+            raise ValueError('Evidence contains a special file')
+        if total + before.st_size > limit:
+            raise ValueError('Evidence exceeds the declared byte budget')
+        hashed, size = hashlib.sha256(), 0
+        with ExitStack() as stack:
+            out = stack.enter_context(destination.open('xb')) if destination else None
+            while chunk := os.read(fd, min(1024**2, before.st_size - size + 1)):
+                size += len(chunk); total += len(chunk)
+                if size > before.st_size or total > limit:
+                    raise ValueError('Evidence grew during bounded copy/hash')
+                hashed.update(chunk)
+                if out:
+                    out.write(chunk)
+        after = os.fstat(fd)
+        identity = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
+        if size != before.st_size or identity(before) != identity(after):
+            raise ValueError('Evidence changed while being read')
+        if destination:
+            os.utime(destination, ns=(before.st_atime_ns, before.st_mtime_ns))
+        files.append({'path': relative.as_posix() or path.name, 'bytes': size, 'sha256': hashed.hexdigest()})
+    path = path.absolute()
+    # Anchor each component; replacement symlinks cannot redirect the copy.
+    fd = os.open(path.anchor, flags | os.O_DIRECTORY)
+    try:
+        for index, part in enumerate(path.parts[1:]):
+            child = os.open(part, flags | (os.O_DIRECTORY if index < len(path.parts) - 2 else 0), dir_fd=fd)
+            os.close(fd); fd = child
+        directory = stat.S_ISDIR(os.fstat(fd).st_mode)
+        visit(fd, Path('') if directory else Path(path.name), copy_to)
+    finally:
+        os.close(fd)
+    return sorted(files, key=lambda row: row['path'])
