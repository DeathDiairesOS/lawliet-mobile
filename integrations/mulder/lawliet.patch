+def _migrate_temporal_contract(conn: Connection) -> None:
+    """Add qualified time columns without changing any historical value/text."""
+    existing = {row[1] for row in conn.execute(text("PRAGMA table_info(windows)"))}
+    for name, declaration in (
+        ("event_time_utc", "TEXT"),
+        ("event_time_original", "TEXT"),
+        ("event_time_status", "TEXT DEFAULT 'legacy_unverified'"),
+        ("temporal_version", "INTEGER NOT NULL DEFAULT 0"),
+    ):
+        if name not in existing:
+            conn.execute(text(f"ALTER TABLE windows ADD COLUMN {name} {declaration}"))
+    conn.execute(text("CREATE INDEX IF NOT EXISTS ix_windows_qualified_time ON windows(temporal_version,event_time_utc,window_id)"))
+
+
+def _window_from_row(row: Any) -> WindowRow:
+    """Only expose version-qualified UTC as chronology; preserve old index hints."""
+    version = row.temporal_version or 0
+    return WindowRow(
+        window_id=row.window_id, source_id=row.source_id,
+        line_start=row.line_start, line_end=row.line_end, raw_text=row.raw_text,
+        event_time=row.event_time_utc if version == TEMPORAL_VERSION else None,
+        event_time_original=row.event_time_original,
+        event_time_status=row.event_time_status if version == TEMPORAL_VERSION else ("legacy_unverified" if version == 0 else "unsupported_temporal_version"),
+        event_time_precision=timestamp_precision(row.event_time_original) if version == TEMPORAL_VERSION else None,
+        temporal_version=version, event_time_index_value=row.event_time,
+    )
+
+
+def _time_filter(stmt: Any, start: str | None, end: str | None) -> Any:
+    start, end = normalize_bounds(start, end)
+    if start is not None or end is not None:
+        stmt = stmt.where(windows_t.c.temporal_version == TEMPORAL_VERSION,
+                          windows_t.c.event_time_utc.isnot(None))
+    if start is not None:
+        stmt = stmt.where(windows_t.c.event_time_utc >= start)
+    if end is not None:
+        stmt = stmt.where(windows_t.c.event_time_utc <= end)
+    return stmt
+
