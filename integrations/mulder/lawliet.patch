+++ b/src/mulder/temporal.py
@@ -0,0 +1,111 @@
+"""Versioned, conservative time indexing; raw evidence is never rewritten.
+
+A window timestamp is a search anchor, not an assertion that every record in
+that window occurred then. Only a single unambiguous explicit-offset instant
+qualifies. Unknown zones, day-only values and differing instants remain undated.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date, datetime, timezone
+import re
+
+TEMPORAL_VERSION = 1
+_DATE = re.compile(r"\d{4}-\d{2}-\d{2}\Z")
+_FULL = re.compile(r"\d{4}-\d{2}-\d{2}[Tt ]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:?\d{2})?\Z")
+_CANDIDATE = re.compile(r"(?<![\w])\d{4}-\d{2}-\d{2}(?:[Tt ]\d{2}:\d{2}(?::\d{2})?(?:[.,]\d+)?(?:[Zz]|[+-][0-9:]+)?)?(?![\w])")
+_LOCAL = re.compile(r"(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}|\d{2}/\d{2}/\d{4}\s+\d{2}:\d{2}:\d{2}")
+
+
+@dataclass(frozen=True)
+class TemporalValue:
+    utc: str | None
+    original: str | None
+    status: str
+
+
+def normalize_timestamp(value: str | None) -> TemporalValue:
+    """Accept ISO seconds/microseconds with an explicit, known UTC offset."""
+    if value is None:
+        return TemporalValue(None, None, "absent")
+    if not isinstance(value, str):
+        raise ValueError("Timestamp must be text or null")
+    if len(value) > 128:
+        return TemporalValue(None, None, "timestamp_token_limit")
+    if _DATE.fullmatch(value):
+        try:
+            date.fromisoformat(value)
+        except ValueError:
+            return TemporalValue(None, value, "invalid")
+        return TemporalValue(None, value, "date_only")
+    if not _FULL.fullmatch(value):
+        return TemporalValue(None, value, "invalid")
+    fraction = re.search(r"\.(\d+)", value)
+    if fraction and len(fraction[1]) > 6:
+        return TemporalValue(None, value, "unsupported_precision")
+    if value.endswith(("-00:00", "-0000")):
+        return TemporalValue(None, value, "unknown_offset")
+    offset = re.search(r"[+-](\d{2}):?(\d{2})$", value)
+    if offset and (int(offset[1]) > 23 or int(offset[2]) > 59):
+        return TemporalValue(None, value, "invalid")
+    try:
+        parsed = datetime.fromisoformat(value.replace("t", "T").replace("z", "+00:00").replace("Z", "+00:00"))
+        if parsed.tzinfo is None:
+            return TemporalValue(None, value, "unknown_timezone")
+        utc = parsed.astimezone(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
+    except (ValueError, OverflowError):
+        return TemporalValue(None, value, "invalid")
+    return TemporalValue(utc, value, "explicit_offset")
+
+
+def timestamp_precision(value: str | None) -> str | None:
+    """Describe represented precision; UTC zero-padding never improves it."""
+    if value is None:
+        return None
+    if _DATE.fullmatch(value):
+        return "day"
+    if not _FULL.fullmatch(value):
+        return None
+    fraction = re.search(r"\.(\d+)", value)
+    return f"fractional_second_{len(fraction[1])}_digits" if fraction else "second"
+
+
+def extract_timestamp(text: str) -> TemporalValue:
+    """Inspect all ISO candidates; never use the first of differing instants."""
+    candidates: list[str] = []
+    seen: set[str] = set()
+    for match in _CANDIDATE.finditer(text):
+        if match.end() - match.start() > 128:
+            return TemporalValue(None, None, "timestamp_token_limit")
+        if match[0] not in seen:
+            if len(candidates) == 64:
+                return TemporalValue(None, candidates[0], "candidate_limit")
+            seen.add(match[0])
+            candidates.append(match[0])
+    local = _LOCAL.search(text)
+    if not candidates:
+        return TemporalValue(None, local[0], "unknown_timezone") if local else TemporalValue(None, None, "absent")
+    values = [normalize_timestamp(value) for value in candidates]
+    # The raw text preserves every candidate. The first representation is
+    # retained only as a locator; status prevents treating it as a selected time.
+    if local or len(values) > 1 and (any(value.utc is None for value in values) or len({value.utc for value in values}) > 1):
+        return TemporalValue(None, candidates[0], "multiple_timestamps")
+    return values[0]
+
+
+def normalize_bounds(start: str | None, end: str | None) -> tuple[str | None, str | None]:
+    """Inclusive UTC bounds. A date explicitly means UTC midnight, not a day."""
+    result = []
+    for name, value in (("start", start), ("end", end)):
+        if value is None:
+            result.append(None)
+            continue
+        parsed = normalize_timestamp(value)
+        if parsed.status == "date_only":
+            parsed = normalize_timestamp(value + "T00:00:00Z")
+        if parsed.utc is None:
+            raise ValueError(f"Invalid {name} time bound: use an explicit-offset ISO timestamp with at most six fractional digits, or YYYY-MM-DD (UTC midnight)")
+        result.append(parsed.utc)
+    if result[0] is not None and result[1] is not None and result[0] > result[1]:
+        raise ValueError("Start time must not be after end time")
