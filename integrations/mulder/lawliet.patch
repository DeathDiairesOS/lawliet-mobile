+def _query_android_with_coverage(db_path: Path, query: str) -> tuple[list[str], dict[str, object]]:
+    """Preserve typed rows and explicitly disclose incomplete/error views.
+
+    Ancalor downstream change: remove the legacy silent SQL sample limit,
+    retain source row IDs for SMS, and bound memory at 100,000 rows per source.
+    This does not establish that a supplied WAL belongs to its database.
+    """
+    limit = 100_000
+    query = _re.sub(r"\s+LIMIT\s+\d+\s*$", "", query, flags=_re.I)
+    if query.startswith("SELECT address, body, date, type FROM sms"):
+        query = "SELECT rowid AS source_rowid, * FROM sms ORDER BY date DESC"
+    coverage: dict[str, object] = {"path": str(db_path), "query": query,
+                                   "row_limit": limit, "warnings": []}
+    warnings = coverage["warnings"]
+    assert isinstance(warnings, list)
+    try:
+        with db_path.open("rb") as evidence:
+            header = evidence.read(20)
+        if len(header) >= 20 and header[:16] == b"SQLite format 3\x00" and header[18:20] == b"\x02\x02":
+            wal = Path(str(db_path) + "-wal")
+            wal_present = wal.is_file()
+            wal_bytes = wal.stat().st_size if wal_present else None
+            coverage["wal"] = {"present": wal_present, "bytes": wal_bytes, "pairing": "unverified"}
+            if not wal_present or wal_bytes <= 32:
+                warnings.append("WAL companion absent or empty: only the checkpointed database view is available; completeness is unknown.")
+            else:
+                warnings.append("WAL companion present: SQLite's readable view does not independently establish DB/WAL pairing; completeness is limited pending provenance verification.")
+        with _phone_sqlite_connection(db_path) as conn:
+            conn.row_factory = sqlite3.Row
+            rows = conn.execute(query).fetchmany(limit + 1)
+        truncated = len(rows) > limit
+        if truncated:
+            rows = rows[:limit]
+            warnings.append("Row limit reached: additional rows exist and were not indexed.")
+        coverage.update({"state": "limited" if warnings else ("parsed" if rows else "empty"),
+                         "rows_returned": len(rows), "truncated": truncated})
+        lines = [json.dumps(dict(row), ensure_ascii=False,
+                            default=lambda value: {"sqlite_blob_hex": value.hex()}
+                            if isinstance(value, bytes) else str(value)) for row in rows]
+        return lines, coverage
+    except sqlite3.Error as exc:
+        code = (getattr(exc, "sqlite_errorcode", 0) or 0) & 0xff
+        state = "corrupt" if code in (sqlite3.SQLITE_CORRUPT, sqlite3.SQLITE_NOTADB) else "query_failed"
+        if "no such table" in str(exc).lower() or "no such column" in str(exc).lower():
+            state = "unsupported_schema"
+        coverage.update({"state": state, "error": str(exc), "rows_returned": 0})
+        return [], coverage
+    except OSError as exc:
+        coverage.update({"state": "inaccessible", "error": str(exc), "rows_returned": 0})
