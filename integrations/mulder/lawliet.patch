+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def import_ancalor_chat_review(case_path: str, evidence_path: str,
+                               date_order: str, timezone_name: str | None = None,
+                               year_century: int | None = None) -> dict[str, object]:
+    """Retain a supplied WhatsApp TXT export in this active Mulder review case.
+
+    Input must already be in the active case evidence or proven derived roots.
+    Uses the existing Ancalor parser and preserves each imported occurrence.
+    Date order and optional timezone/century are operator declarations, not
+    device metadata. Unknown or ambiguous times remain undated. Editable text
+    does not authenticate sender identity, completeness or attachment contents.
+    Existing exports are prior snapshots; query or generate a new report after
+    importing. No network access, media retrieval, examiner approval or release.
+    """
+    from lawliet_mobile.core import connect, audit, verify
+    from lawliet_mobile.messages import import_chat
+
+    root = _ancalor_review_case(case_path)
+    from mulder.server.case_scope import resolve_case_read_path
+    source = resolve_case_read_path(Path(evidence_path))
+    if (any(p.is_symlink() for p in (source, *source.parents)) or
+            not source.is_file() or source.suffix.lower() != '.txt'):
+        raise ValueError('Choose one regular supplied WhatsApp TXT file; symlinks are refused')
+    if source.stat().st_size > 64 * 1024**2:
+        raise ValueError('Chat input exceeds the 64 MiB accepted file ceiling')
+    with connect(root.parent, root.name) as (_, db):
+        before = verify(root, db)
+        if not before['ok']:
+            raise ValueError('Existing review case integrity failed; chat import refused')
+        result = import_chat(root, db, source, date_order, timezone_name,
+                             year_century=year_century)
+        audit(db, 'mulder.chat_review.imported', {'import': result,
+                                                'existing_exports_refreshed': False})
+        integrity = verify(root, db)
+    return {'case_path': str(root), 'import': result, 'integrity': integrity,
+            'existing_exports_refreshed': False,
+            'scope': 'Supplied editable chat export; no acquisition, identity or attachment assurance.'}
