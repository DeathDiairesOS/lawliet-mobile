+"""Bounded exact-byte inspection restricted to the active Mulder review case."""
+from mulder.server.app import mcp
+from mulder.server.helpers import error_response, make_tool_call_id
+from mulder.server.tool_access import Role, tool_access
+from mulder.server.tools.lawliet_sqlite_workspace import _review_case
+
+
+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def inspect_ancalor_evidence(case_path: str, file_id: int, offset: int = 0,
+                             length: int = 4096, encoding: str = 'utf-8',
+                             format_name: str | None = None) -> dict[str, object]:
+    """Inspect exact source bytes/offsets with explicit derived text/structure.
+
+    Select a retained file_id in a direct lawliet-review child of this active
+    Mulder case. Max64KiB window, 512MiB verified source. JSON/XML/plist are
+    explicit optional whole-file derived views, capped1MiB input and isolated
+    for5seconds. No arbitrary paths or symlinks. Hex is authoritative; invalid
+    text decoding is visible and structured nodes are not byte-offset maps.
+    No artifact/finding/deletion inference. Unsupported binary formats refused.
+    """
+    from lawliet_mobile.core import UserError, connect
+    from lawliet_mobile.evidence_viewer import inspect_file
+    params = dict(case_path=case_path, file_id=file_id, offset=offset, length=length,
+                  encoding=encoding, format_name=format_name)
+    tc_id = make_tool_call_id()
+    try:
+        selected = _review_case(case_path)
+        with connect(selected.parent, selected.name) as (root, db):
+            result = inspect_file(root, db, file_id, offset, length, encoding, format_name)
+        return {'tool_call_id': tc_id, 'status': 'success', 'result': result}
+    except (UserError, OSError, ValueError) as exc:
+        return error_response(tc_id, 'inspect_ancalor_evidence', params, str(exc), error_type='invalid_or_unavailable_view')
diff --git a/src/mulder/server/tools/lawliet_recovery.py b/src/mulder/server/tools/lawliet_recovery.py
