+@tool_access(Role.EXTRACT_EXECUTOR)
+def list_ancalor_files(case_path: str, query: str = '', offset: int = 0,
+                       limit: int = 100) -> dict[str, object]:
+    """List retained evidence files and their recorded whole-file SHA256.
+
+    Literal Unicode path matching; returns file IDs for source inspection and
+    read-only SQLite queries. Inventory hashes are not independently
+    authenticated source identity. Does not execute evidence or a parser.
+    """
+    from lawliet_mobile.core import connect
+    root = _ancalor_review_case(case_path)
+    if not isinstance(query, str) or len(query) > 4096 or type(offset) is not int or offset < 0 or type(limit) is not int or not 1 <= limit <= 1000:
+        raise ValueError('Use bounded literal query, nonnegative offset and limit 1–1000')
+    with connect(root.parent, root.name) as (_, db):
+        db.create_function('inventory_match', 1, lambda p: int(query.casefold() in str(p).casefold()), deterministic=True)
+        total = db.execute('SELECT COUNT(*) FROM files WHERE inventory_match(logical_path)', ()).fetchone()[0]
+        rows = [dict(r) for r in db.execute('SELECT id,evidence_id,path,logical_path,sha256,size FROM files WHERE inventory_match(logical_path) ORDER BY logical_path,id LIMIT ? OFFSET ?', (limit,offset))]
+    return {'case_path': str(root), 'files': rows, 'total': total, 'offset': offset,
+            'has_more': offset+len(rows)<total, 'hash_scope': 'Recorded SHA256 of whole retained file; reverify bytes before citation.'}
