+def _backup_inventory(root: Path, max_backup_bytes: int = 2 * 1024**3) -> dict[str, dict[str, object]]:
+    """Bound inventory by both declared stat sizes and actual hashed bytes."""
+    import hashlib
+    import os
+    import stat
+    if type(max_backup_bytes) is not int or not 0 < max_backup_bytes <= 3 * 1024**3:
+        raise ValueError('Invalid backup inventory byte ceiling')
+    if root.is_symlink() or not root.is_dir():
+        raise ValueError('Backup must be a regular directory')
+    result = {}
+    total = 0
+    def identity(info):
+        return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+    for entries, path in enumerate(root.rglob('*'), 1):
+        if entries > 200000:
+            raise ValueError('Backup exceeds 200000 filesystem entries')
+        if path.is_symlink():
+            raise ValueError('Backup symlinks are not supported')
+        if path.is_dir():
+            continue
+        initial = path.stat()
+        if not stat.S_ISREG(initial.st_mode):
+            raise ValueError('Backup contains a nonregular file')
+        relative = str(path.relative_to(root))
+        file_limit = min(max_backup_bytes, 2*1024**3 if relative == 'Manifest.db'
+                         else 16*1024**2 if relative == 'Manifest.plist' else max_backup_bytes)
+        if len(result) >= 100000 or initial.st_size > file_limit or total + initial.st_size > max_backup_bytes:
+            raise ValueError('Backup exceeds file count, per-file or selected byte ceiling')
+        hashed = hashlib.sha256()
+        file_bytes = 0
+        with path.open('rb') as stream:
+            if identity(os.fstat(stream.fileno())) != identity(initial):
+                raise ValueError('Backup file changed before hashing')
+            while True:
+                # One extra byte detects growth without allowing unbounded reads
+                # or hashing beyond the initial per-file / overall ceilings.
+                chunk = stream.read(min(1024**2, initial.st_size - file_bytes + 1,
+                                        max_backup_bytes - total + 1))
+                if not chunk:
+                    break
+                if file_bytes + len(chunk) > initial.st_size or total + len(chunk) > max_backup_bytes:
+                    raise ValueError('Backup file grew while hashing')
+                file_bytes += len(chunk)
+                total += len(chunk)
+                hashed.update(chunk)
+            if file_bytes != initial.st_size or identity(os.fstat(stream.fileno())) != identity(initial):
+                raise ValueError('Backup file changed while hashing')
+        if identity(path.stat()) != identity(initial):
+            raise ValueError('Backup file changed after hashing')
+        result[relative] = {'bytes':file_bytes,'sha256':hashed.hexdigest()}
+    return result
+
