@@ -0,0 +1,60 @@
+"""Bounded examiner SQL over imported files belonging to the active Mulder case."""
+from pathlib import Path
+import time
+from mulder.server.app import get_ctx, mcp
+from mulder.server.helpers import error_response, make_tool_call_id, tool_response
+from mulder.server.tool_access import Role, tool_access
+
+
+def _review_case(case_path):
+    from lawliet_mobile.mulder_ownership import require_review_case
+    return require_review_case(case_path,get_ctx().db.db_path)
+
+
+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def run_ancalor_sqlite_query(case_path: str, file_id: int, sql: str,
+                             row_limit: int = 1000, max_output_bytes: int = 8388608,
+                             timeout_seconds: float = 5) -> dict[str, object]:
+    """Run bounded read-only SQL on an imported SQLite file in this Mulder case.
+
+    Uses disposable copies with source hashes, preserves query/results/receipts,
+    and returns a bounded preview of ordered rows (duplicate columns retained).
+    Only SELECT/read operations accepted; no attachment or extension loading.
+    WAL pairing is unverified. SQL results are observations, not findings or
+    deleted-record confirmation; empty results do not establish absence.
+    case_path must be a direct retained lawliet-review child of the active case.
+    Limits: 1–100000 rows, 1024–16777216 output bytes, 0.05–30 seconds.
+    """
+    from lawliet_mobile.core import UserError, connect
+    from lawliet_mobile.sqlite_workspace import query
+    tc_id = make_tool_call_id()
+    started = time.monotonic()
+    params = dict(case_path=case_path, file_id=file_id, sql=sql, row_limit=row_limit,
+                  max_output_bytes=max_output_bytes, timeout_seconds=timeout_seconds)
+    try:
+        root = _review_case(case_path)
+        # This explicit endpoint must never silently choose trusted host SQL.
+        import os
+        if os.environ.get('LAWLIET_MCP_PROFILE') == 'sqlite-container':
+            from lawliet_mobile.sqlite_container import configured
+            profile = configured(root)
+            pinned_socket = os.environ.get('LAWLIET_CONTAINER_SOCKET')
+            if (profile is None or not pinned_socket
+                    or profile['socket'] != str(Path(pinned_socket).resolve())):
+                raise UserError('SQLite container endpoint requires configured isolation and its pinned local socket; no host fallback.')
+        with connect(root.parent, root.name) as (case, db):
+            result = query(case, db, file_id, sql, row_limit=row_limit,
+                           max_output_bytes=max_output_bytes, timeout_seconds=timeout_seconds)
+        result['case_path'] = str(root)
+        result['interpretation_limit'] = 'Examiner query observations only; no finding, deletion or absence determination.'
+        if result['status'] == 'failed':
+            response = error_response(tc_id, 'run_ancalor_sqlite_query', params,
+                                      'SQLite query failed; retained receipt contains execution details.', error_type='query_failed')
+        else:
+            response = tool_response(tc_id, 'run_ancalor_sqlite_query', params, result,
+                                     'phone.lawliet_sqlite_workspace', (time.monotonic() - started) * 1000)
+        response['result'] = result
+        return response
+    except (UserError, OSError, ValueError) as exc:
+        return error_response(tc_id, 'run_ancalor_sqlite_query', params, str(exc), error_type='invalid_or_unavailable_query')
