@@ -0,0 +1,75 @@
+"""Explicit contained import of one report already retained in the active case."""
+import hashlib
+import os
+from pathlib import Path
+import tempfile
+import time
+from typing import Literal
+from pydantic import StrictInt
+from mulder.server.app import get_ctx, mcp
+from mulder.server.helpers import error_response, make_tool_call_id, tool_response
+from mulder.server.tool_access import Role, tool_access
+
+
+@tool_access(Role.EXTRACT_EXECUTOR)
+def run_lawliet_report_import(case_path: str, file_id: StrictInt,
+                              format_name: Literal['jsonl', 'tsv']) -> dict[str, object]:
+    """Import one retained derived report under the explicit container profile.
+
+    No acquisition or ALEAPP/iLEAPP rerun. Select an active-case retained file
+    ID, not a raw path. Max32MiB input, bounded normalized output, no host
+    fallback. The report's claims remain unverified against the phone/database.
+    Whole-folder reports and report release are outside this tool's scope.
+    """
+    from lawliet_mobile.core import UserError, connect, verify
+    from lawliet_mobile.child_output import ChildOutputs
+    from lawliet_mobile.mulder_ownership import require_review_case
+    from lawliet_mobile.parsed_import import import_parsed
+    from lawliet_mobile.report_container import configured
+    tc_id=make_tool_call_id();started=time.monotonic()
+    params={'case_path':case_path,'file_id':file_id,'format_name':format_name}
+    try:
+        if os.environ.get('LAWLIET_MCP_PROFILE')!='report-container':
+            raise UserError('Use the explicit report-container endpoint; no host fallback.')
+        root=require_review_case(case_path,get_ctx().db.db_path)
+        cfg=configured(root);socket=os.environ.get('LAWLIET_CONTAINER_SOCKET')
+        if cfg is None or not socket or cfg['socket']!=str(Path(socket).resolve()):
+            raise UserError('Configured report isolation and pinned socket required; no host fallback.')
+        if type(file_id) is not int or file_id<1 or format_name not in {'jsonl','tsv'}:
+            raise UserError('Select a positive retained file ID and jsonl or tsv format.')
+        with connect(root.parent,root.name) as (_,db):
+            row=db.execute('SELECT * FROM files WHERE id=?',(file_id,)).fetchone()
+            if not row or type(row['size']) is not int or not 0<=row['size']<=32*1024**2:
+                raise UserError('Retained report is missing or exceeds32MiB.')
+            source=root/'evidence'/row['evidence_id']/row['path']
+            if not source.absolute().is_relative_to((root/'evidence'/row['evidence_id']).absolute()) or '..' in source.parts:
+                raise UserError('Unsafe retained report location.')
+            with ChildOutputs(source.parent) as outputs:
+                data=outputs.read(source.name,32*1024**2);outputs.check_directory()
+            observed=hashlib.sha256(data).hexdigest()
+            if len(data)!=row['size'] or observed!=row['sha256']:
+                raise UserError('Retained report integrity mismatch.')
+            # Intake the verified snapshot with its original schema-selecting
+            # filename. A later path replacement cannot swap the imported bytes.
+            with tempfile.TemporaryDirectory(prefix='lawliet-report-snapshot-') as folder:
+                snapshot=Path(folder)/source.name
+                with snapshot.open('xb') as stream:stream.write(data)
+                result=import_parsed(root,db,snapshot,format_name,
+                                     f'Derived report: {row["logical_path"]} (source file {file_id})',
+                                     contained=True,origin_file_id=file_id)
+            integrity=verify(root,db)
+        result.update(case_path=str(root),selected_file_id=file_id,
+                      selected_report_sha256=observed)
+        response=tool_response(tc_id,'run_lawliet_report_import',params,result,
+                               None,(time.monotonic()-started)*1000)
+        response.update(result=result,integrity=integrity,
+                        scope='Derived report interpretation only; no source-device completeness or independent truth assurance.')
+        return response
+    except (UserError,OSError,ValueError) as exc:
+        return error_response(tc_id,'run_lawliet_report_import',params,str(exc),
+                              error_type='invalid_or_unavailable_report_import')
+
+
+# Existing standard/SMS/SQL/native/Exif registrations remain unchanged.
+if os.environ.get('LAWLIET_MCP_PROFILE') == 'report-container':
+    run_lawliet_report_import=mcp.tool()(run_lawliet_report_import)
diff --git a/src/mulder/server/tools/lawliet_sqlite_workspace.py b/src/mulder/server/tools/lawliet_sqlite_workspace.py
