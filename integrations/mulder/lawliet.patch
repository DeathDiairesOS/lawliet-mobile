@@ -0,0 +1,166 @@
+"""Explicit scoped zero-finding reports for the MCP examination workflow.
+
+This does not alter the autonomous investigation phase gates, establish device
+cleanliness, or infer successful detection from a parser invocation.
+"""
+from __future__ import annotations
+
+import html
+import inspect
+import json
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Literal
+
+from pydantic import BaseModel, ConfigDict, Field, StrictInt, field_validator, model_validator
+
+from mulder.server.helpers import hash_output
+
+
+class AnalysisReference(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    source_id: StrictInt = Field(gt=0)
+    tool_call_id: str = Field(min_length=1, max_length=200)
+
+
+class ScopedExamination(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    outcome: Literal['no_matches', 'inconclusive']
+    objective: str = Field(min_length=10, max_length=4000)
+    scope: str = Field(min_length=10, max_length=4000)
+    limitations: list[str] = Field(min_length=1, max_length=20)
+    unanswered_questions: list[str] = Field(default_factory=list, max_length=20)
+    analysis: list[AnalysisReference] = Field(min_length=1, max_length=20)
+
+    @field_validator('objective', 'scope')
+    @classmethod
+    def meaningful_text(cls, value):
+        if len(value.strip()) < 10:
+            raise ValueError('Provide explicit objective and examination scope')
+        return value.strip()
+
+    @field_validator('limitations', 'unanswered_questions')
+    @classmethod
+    def bounded_text_list(cls, values):
+        if any(not isinstance(v, str) or not v.strip() or len(v) > 2000 for v in values):
+            raise ValueError('Entries must be nonempty text of at most 2000 characters')
+        return [v.strip() for v in values]
+
+    @model_validator(mode='after')
+    def inconclusive_questions(self):
+        if self.outcome == 'inconclusive' and not self.unanswered_questions:
+            raise ValueError('An inconclusive examination requires unanswered questions')
+        return self
+
+
+def assess_examination(ctx, examination):
+    """Validate real same-case query provenance; return gates and current snapshot."""
+    request = ScopedExamination.model_validate(examination)
+    gates = []
+    def gate(name, passed, detail):
+        gates.append({'name': name, 'passed': bool(passed), 'detail': detail})
+    gate('zero_finding_path', not ctx.db.get_findings() and not ctx.db.get_invalid_findings(),
+         'This explicit path requires zero valid and zero invalid findings; existing findings must use the normal report route.')
+    metadata = ctx.db.get_case_metadata()
+    gate('narrative_submitted', bool(metadata.narrative and metadata.narrative.strip()),
+         'A submitted narrative is required; the scoped report also retains the explicit limitations.')
+    counts = ctx.audit.summary().tool_call_counts
+    gate('audit_tools_called', all(n in counts for n in ('audit_evidence_coverage', 'audit_tool_coverage')),
+         'Both coverage audits must have been invoked; invocation alone does not prove completeness or success.')
+    sources = {s.source_id: s for s in ctx.db.get_sources()}
+    provenance = []
+    seen = set()
+    for position, ref in enumerate(request.analysis, 1):
+        source = sources.get(ref.source_id)
+        calls, _ = ctx.audit._resolve_tool_calls([ref.tool_call_id])
+        call = calls[0] if len(calls) == 1 else None
+        params = call.params if call else {}
+        queries = params.get('queries') or []
+        terms = ([params['query']] if params.get('query') else []) + queries if isinstance(queries, list) else []
+        excluded = params.get('exclude_sources') or []
+        valid = (source is not None and source.case_id == metadata.case_id and source.line_count > 0
+                 and bool(source.source_path and source.source_hash)
+                 and call is not None and call.tool_name == 'search'
+                 and params.get('source') == source.source_name
+                 and params.get('evidence_path') == source.source_path
+                 and type(params.get('max_results')) is int and 1 <= params['max_results'] <= 500
+                 and params.get('regex') is False
+                 and isinstance(terms, list) and 1 <= len(terms) <= 20
+                 and all(isinstance(t, str) and t.strip() and len(t) <= 2000 for t in terms)
+                 and isinstance(excluded, list)
+                 and all(isinstance(n, str) for n in excluded)
+                 and not any(source.source_name == n or source.source_name.startswith(n + '.') for n in excluded)
+                 and bool(call.output_hash))
+        empty = call is not None and call.output_hash == hash_output([])
+        if request.outcome == 'no_matches':
+            valid = valid and empty
+        key = (ref.source_id, ref.tool_call_id)
+        valid = valid and key not in seen
+        seen.add(key)
+        recheck = None
+        if valid:
+            # Recheck the exact saved scope against the current index. Historical
+            # zero-result calls cannot establish absence after new indexing.
+            from mulder.server.tools.core import search
+            try:
+                recheck = inspect.unwrap(search)(**{**params, 'max_results': 1})
+                valid = recheck.get('status') == 'success'
+                if request.outcome == 'no_matches':
+                    valid = valid and recheck.get('total_matches') == 0
+            except Exception:
+                valid = False
+        gate('analysis_reference_' + str(position), valid,
+             'Requires a same-case non-regex search, exact source name/path, nonempty query, positive result limit, no source exclusion, and a successful current-index recheck. no_matches also requires original and current empty results.')
+        if valid:
+            provenance.append({'source': source.model_dump(), 'tool_call': call.model_dump(),
+                               'retained_result_state': 'empty_results' if empty else 'not_verified_empty',
+                               'current_index_recheck': {k: recheck.get(k) for k in ('tool_call_id', 'status', 'total_matches', 'has_more')},
+                               'source_snapshot_time': 'report validation',
+                               'reference_precision': 'Audited search invocation and registered source identity; no fabricated record offsets.'})
+    current_sources = {s.source_id: s for s in ctx.db.get_sources()}
+    gate('source_snapshot_unchanged', all(current_sources.get(ref.source_id) == sources.get(ref.source_id) for ref in request.analysis),
+         'Registered source metadata must remain unchanged during the current-index rechecks.')
+    snapshot = {'schema_version': 1, 'case_id': metadata.case_id,
+                'case_ingested_at': metadata.ingested_at,
+                'evidence_root': metadata.evidence_root,
+                'examination': request.model_dump(), 'analysis_provenance': provenance,
+                'registered_sources_not_selected': len(set(sources) - {r.source_id for r in request.analysis}),
+                'review_status': 'unreviewed', 'narrative': metadata.narrative,
+                'generated_at': datetime.now(timezone.utc).isoformat(),
+                'limitations_of_validation': [
+                    'No matches applies only to the recorded searches of indexed material, including their filters; it is not a device-wide assessment.',
+                    'A registered source hash identifies parser output, not necessarily original acquired bytes. Source identities below are the current index snapshot; historical audit entries do not bind an earlier source revision.',
+                    'Audit references establish invocations and output commitments, not examiner approval, detection completeness, or acquisition completeness.',
+                    'The separate autonomous investigate workflow retains its original finding and MITRE gates.']}
+    return gates, snapshot
+
+
+def write_examination_report(ctx, snapshot, tc_id):
+    """Preserve a uniquely named unreviewed report and structured source receipt."""
+    request = snapshot['examination']
+    label = 'No matches in the recorded searches' if request['outcome'] == 'no_matches' else 'Inconclusive examination'
+    # JSON quoting makes embedded evidence visibly data, never executable HTML.
+    encoded = json.dumps(snapshot, ensure_ascii=False, indent=2)
+    if len(encoded.encode('utf-8')) > 1024 * 1024:
+        raise ValueError('Scoped report exceeds one MiB; shorten the narrative or scope')
+    fence = '`' * max(3, max((len(m.group()) + 1 for m in re.finditer(r'`+', encoded)), default=3))
+    body = ('# Scoped Examination Report — UNREVIEWED\n\n' + label + '\n\n'
+            'This report does not establish that a device is free of compromise. '
+            'It requires examiner review before release.\n\n'
+            'The recorded scope, limitations, narrative and source-linked analysis follow. '
+            'Only the listed searches are represented; uncollected, unindexed and unselected material remains outside this conclusion.\n\n'
+            + fence + 'json\n' + encoded + '\n' + fence + '\n')
+    folder = Path(ctx.db.db_path).parent
+    paths = {kind: folder / ('examination-' + tc_id + suffix) for kind, suffix in
+             [('report_path', '.md'), ('html_report_path', '.html'), ('examination_path', '.json')]}
+    documents = {'report_path': body,
+                 'html_report_path': '<!doctype html><meta charset="utf-8"><title>Scoped Examination — Unreviewed</title><pre>' + html.escape(body) + '</pre>',
+                 'examination_path': encoded + '\n'}
+    for name, path in paths.items():
+        with path.open('x', encoding='utf-8') as handle:
+            handle.write(documents[name])
+    return {'status': 'success', **{k: str(p) for k, p in paths.items()},
+            'outcome': request['outcome'], 'outcome_label': label,
+            'review_status': 'unreviewed', 'finding_count': 0,
+            'analysis_reference_count': len(snapshot['analysis_provenance'])}
