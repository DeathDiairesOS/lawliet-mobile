+@mcp.tool()
+@tool_access(Role.EXTRACT_EXECUTOR)
+def run_ancalor_export_review(
+    evidence_path: str,
+    date_order: str = "mdy",
+    timezone_name: str | None = None,
+    year_century: int | None = None,
+) -> dict[str, object]:
+    """Parse a supplied WhatsApp export, vCard or local image through Lawliet.
+
+    Downstream candidate adapter. Preserves a hashed copy and an Lawliet case
+    below the active Mulder case directory, plus JSONL and HTML derivatives.
+    Text exports are editable representations, not authenticated acquisition.
+    Two-digit years require declared century; ambiguous/unknown zones stay undated. No recovery,
+    identity attribution, network access, model execution or media fetching.
+    Other inputs are explicitly unsupported. Images are signature-indexed; use run_exiftool for metadata.
+
+    Args:
+        evidence_path: One .txt WhatsApp export, .vcf contact file, or local JPEG/PNG.
+        date_order: Explicit date component order: mdy, dmy or ymd.
+        timezone_name: Optional operator-declared IANA zone; never inferred.
+        year_century: Optional declared century for two-digit years, e.g. 2000.
+    """
+    from lawliet_mobile.core import create_case, connect, import_evidence, select_artifacts, verify
+    from lawliet_mobile.messages import import_chat
+    from lawliet_mobile.parsers import native_analyze
+    from lawliet_mobile.report import write_export, write_report
+
+    tc_id = make_tool_call_id()
+    t0 = time.monotonic()
+    params = {"evidence_path": evidence_path, "date_order": date_order, "timezone_name": timezone_name, "year_century": year_century}
+    path = Path(evidence_path)
+    if not path.is_file() or path.is_symlink():
+        return error_response(tc_id, "run_ancalor_export_review", params,
+                              "A regular supplied file is required", error_type="invalid_input")
+    if path.suffix.lower() not in {".txt", ".vcf", ".jpg", ".jpeg", ".png"}:
+        return tool_response(tc_id, "run_ancalor_export_review", params,
+                             {"state": "unsupported", "records": 0, "reason": "This adapter supports WhatsApp TXT, vCard, JPEG and PNG signatures only."},
+                             "phone.lawliet_export", (time.monotonic()-t0)*1000)
+    if path.stat().st_size > 64*1024**2:
+        return error_response(tc_id, "run_ancalor_export_review", params,
+                              "Input exceeds the 64 MiB accepted file ceiling", error_type="input_limit")
+    workspace = Path(get_ctx().db.db_path).parent / "lawliet-review"
+    case_id = "EXPORT-" + str(tc_id).replace("_", "-")
+    create_case(workspace, case_id, examiner="Codex/Mulder candidate adapter")
+    with connect(workspace, case_id) as (root, db):
+        if path.suffix.lower() == ".txt":
+            result = import_chat(root, db, path, date_order, timezone_name, year_century=year_century)
+        else:
+            eid, _, _ = import_evidence(root, db, path, "unknown", expand_archives=False)
+            result = native_analyze(root, db, eid)
+        records = select_artifacts(db, limit=None)
+        output = root / "exports"
+        write_export(root, db, output / "records.jsonl", "jsonl", records)
+        write_report(root, db, output / "review.html")
+        integrity = verify(root, db)
+        retained = {"case_path": str(root), "jsonl": str(output/"records.jsonl"), "html": str(output/"review.html")}
+    lines = [json.dumps({"scope": "Supplied export only; no device acquisition, completeness or identity assurance", "retained": retained, "parser_result": result}, ensure_ascii=False)]
+    lines.extend(json.dumps(row, ensure_ascii=False) for row in records)
+    indexed = extract_and_index("\n".join(lines), "phone.lawliet_export", str(path), "lawliet-export-adapter/1")
+    indexed.update({"records": len(records), "record_count_unit": "Lawliet artifacts",
+                    "retained": retained, "originals_unchanged": integrity["ok"],
+                    "parser_result": result, "state": "parsed" if records else "limited"})
+    response = tool_response(tc_id, "run_ancalor_export_review", params, indexed,
+                             "phone.lawliet_export", (time.monotonic()-t0)*1000)
+    response["result"] = indexed
+    return response
